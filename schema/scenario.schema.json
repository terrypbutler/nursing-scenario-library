{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable nursing simulation scenario",
  "type": "object",
  "required": [
    "case_id", "scenario_version", "publication_status", "review", "title",
    "synthetic_data_notice", "field", "setting", "patient", "learning",
    "clinical", "initial_state", "time_events", "allowed_actions",
    "ai_contract", "dialogue", "facilitator_only", "debrief"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^PAT-[0-9]{3}$"},
    "scenario_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publication_status": {"enum": ["development", "approved"]},
    "review": {"type": "object", "required": ["status", "reviewer", "reviewed_at"]},
    "title": {"type": "string", "minLength": 5},
    "synthetic_data_notice": {"const": "Entirely fictional training case"},
    "field": {"const": "adult nursing"},
    "setting": {"type": "string", "minLength": 2},
    "complexity": {"enum": ["introductory", "intermediate"]},
    "estimated_duration_minutes": {"type": "integer", "minimum": 5, "maximum": 60},
    "patient": {"type": "object"},
    "learning": {"type": "object"},
    "clinical": {"type": "object"},
    "initial_state": {"type": "object"},
    "time_events": {"type": "array"},
    "allowed_actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "label", "preconditions", "effects", "reveals"]
      }
    },
    "ai_contract": {
      "type": "object",
      "required": ["allowed_context", "may_generate", "must_not_generate"]
    },
    "dialogue": {
      "type": "object",
      "required": ["opening_line", "action_responses", "fallback_responses", "facts"],
      "properties": {
        "opening_line": {"type": "string", "minLength": 1},
        "action_responses": {"type": "object"},
        "fallback_responses": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
        },
        "facts": {"type": "array"}
      }
    },
    "facilitator_only": {"type": "object"},
    "debrief": {
      "type": "object",
      "required": ["automatic_competence_decision"]
    }
  },
  "additionalProperties": false
}
